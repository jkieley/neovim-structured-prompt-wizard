{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Prompt Wizard catalog",
  "description": "Template IDs and field IDs must be unique within their respective lists; the plugin also checks this at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "label": { "type": "string", "minLength": 1, "allOf": [{ "pattern": "\\S" }, { "not": { "pattern": "[\\r\\n]" } }] },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/label" },
        "description": { "type": "string" },
        "instructions": { "type": "string", "description": "Reusable directions prepended to the rendered field sections." },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "hint": { "type": "string", "description": "Editor placeholder only; not included in output." },
        "default": { "type": "string", "description": "Editable initial answer; may contain newlines." },
        "required": { "type": "boolean", "default": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "url": { "type": "string", "pattern": "^https?://\\S+$" }
      }
    }
  }
}
